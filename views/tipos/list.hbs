<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Mantenimiento de Tipos</h2>
    <a href="/tipos/crear" class="btn btn-success">Crear Nuevo Tipo</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nombre del tipo</th>
            <th style="width: 200px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        {{#each tiposList}}
        <tr>
            <td>{{this.name}}</td>
            <td>
                <a href="/tipos/editar/{{this.id}}" class="btn btn-sm btn-warning">Editar</a>
                <a href="/tipos/delete/{{this.id}}" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>