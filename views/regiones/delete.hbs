<div class="card border-danger mt-5 mx-auto" style="max-width: 500px;">
    <div class="card-header bg-danger text-white text-center">
        <h4>Confirmar Eliminación</h4>
    </div>
    <div class="card-body text-center">
        <p class="fs-5">¿Está seguro que desea eliminar esta región?</p>
        <h3 class="mb-4">{{region.name}}</h3>
        <form action="/regiones/delete/{{region.id}}" method="POST">
            <a href="/regiones" class="btn btn-secondary me-2">Cancelar</a>
            <button type="submit" class="btn btn-danger">Aceptar</button>
        </form>
    </div>
</div>