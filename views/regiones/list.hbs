<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Mantenimiento de Regiones</h2>
    <a href="/regiones/crear" class="btn btn-success">Crear Nueva Región</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nombre de la Región</th>
            <th style="width: 200px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        {{#each regionesList}}
        <tr>
            <td>{{this.name}}</td>
            <td>
                <a href="/regiones/editar/{{this.id}}" class="btn btn-sm btn-warning">Editar</a>
                <a href="/regiones/delete/{{this.id}}" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>