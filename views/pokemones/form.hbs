<div class="card shadow-sm mt-4">
    <div class="card-header bg-dark text-white">
        <h4>{{#if editMode}}Editar{{else}}Crear{{/if}} Pokémon</h4>
    </div>
    <div class="card-body">
        <form action="{{#if editMode}}/pokemones/editar/{{pokemon.id}}{{else}}/pokemones/crear{{/if}}" method="POST">
            
            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre del Pokémon</label>
                <input type="text" class="form-control" id="nombre" name="nombre" value="{{pokemon.name}}" required>
            </div>

            <div class="mb-3">
                <label for="foto" class="form-label">URL de la Foto</label>
                <input type="url" class="form-control" id="foto" name="foto" value="{{pokemon.foto}}" required>
                {{#if editMode}}
                    <div class="mt-2">
                        <img src="{{pokemon.foto}}" alt="Foto actual" width="100">
                    </div>
                {{/if}}
            </div>

            <div class="mb-3">
                <label for="regionId" class="form-label">Región</label>
                <select class="form-select" id="regionId" name="regionId" required>
                    <option value="">Seleccione una región...</option>
                    {{#each regiones}}
                    <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>

            <div class="mb-3">
                <label for="tipoPrimarioId" class="form-label">Tipo Primario</label>
                <select class="form-select" id="tipoPrimarioId" name="tipoPrimarioId" required>
                    <option value="">Seleccione un tipo...</option>
                    {{#each tipos}}
                    <option value="{{this.id}}" {{#if this.selectedPrimario}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>

            <div class="mb-3">
                <label for="tipoSecundarioId" class="form-label">Tipo Secundario</label>
                <select class="form-select" id="tipoSecundarioId" name="tipoSecundarioId" required>
                    <option value="">Seleccione un tipo...</option>
                    {{#each tipos}}
                    <option value="{{this.id}}" {{#if this.selectedSecundario}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="/pokemones" class="btn btn-secondary">Volver Atrás</a>
                <button type="submit" class="btn btn-primary">{{#if editMode}}Guardar{{else}}Crear{{/if}} Pokémon</button>
            </div>
        </form>
    </div>
</div>